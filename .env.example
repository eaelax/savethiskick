# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The production URL where this application is hosted (e.g., https://yourcustomdomain.com).
# Used for canonical links, sitemaps, OpenGraph metadata, and API references.
APP_URL="https://yourcustomdomain.com"

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: Google Search Console verification code.
# Found in Google Search Console -> Settings -> Ownership Verification -> HTML Tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# NEXT_TELEMETRY_DISABLED: Disables Next.js telemetry in CI/CD and production builds.
NEXT_TELEMETRY_DISABLED="1"
